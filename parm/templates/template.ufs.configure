#############################################
####  UFS Run-Time Configuration File  ######
#############################################

# ESMF #
logKindFlag:            ESMF_LOGKIND_MULTI
globalResourceControl:  true

# EARTH #
{%- if APP == "S2SWA" %}
EARTH_component_list: MED ATM OCN ICE WAV
{%- elif APP == "S2SWAL" %}
EARTH_component_list: MED ATM CHM OCN ICE WAV LND
{%- elif APP == "NG-GODAS" %}
EARTH_component_list: MED ATM OCN ICE
{%- elif APP == "ATM" %}
EARTH_component_list: ATM
{%- endif %}
EARTH_attributes::
  Verbosity = 0
::

{%- if APP == "ATM" %}
# ATM #
ATM_model:                      {{ atm_model }}
ATM_petlist_bounds:             {{ atm_petlist_bounds_n1 }} {{ atm_petlist_bounds_n2 }}
ATM_omp_num_threads:            1
ATM_attributes::
  Verbosity = 0
  Diagnostic = 0
::
# Run Sequence #
runSeq::
  ATM
::
{%- else %}
# MED #
MED_model:                      cmeps
MED_petlist_bounds:             {{ med_petlist_bounds_n1 }} {{ med_petlist_bounds_n2 }}
MED_omp_num_threads:            1
::

  {%- if atm_model %}
# ATM #
ATM_model:                      {{ atm_model }}
ATM_petlist_bounds:             {{ atm_petlist_bounds_n1 }} {{ atm_petlist_bounds_n2 }}
ATM_omp_num_threads:            1
ATM_attributes::
  Verbosity = 0
  DumpFields = false
  {%- if APP == "S2SWA" or APP == "S2SWAL" %}
  ProfileMemory = false
  OverwriteSlice = true
  {%- elif APP == "NG-GODAS" %}
  mesh_atm  = INPUT/{{ atm_mesh_atm }}
  diro = "."
  logfile = atm.log
  stop_n = {{ atm_stop_n }}
  stop_option = nhours
  stop_ymd = -999
  write_restart_at_endofrun = .true.
  {%- endif %}
::
  {%- endif %}

  {%- if chm_model %}
# CHM #
CHM_model:                      {{ chm_model }}
CHM_petlist_bounds:             {{ chm_petlist_bounds_n1 }} {{ chm_petlist_bounds_n2 }}
CHM_omp_num_threads:            1
CHM_attributes::
  Verbosity = 0
::
  {%- endif %}

  {%- if ocn_model %}
# OCN #
OCN_model:                      {{ ocn_model }}
OCN_petlist_bounds:             {{ ocn_petlist_bounds_n1 }} {{ ocn_petlist_bounds_n2 }}
OCN_omp_num_threads:            1
OCN_attributes::
  Verbosity = 0
  DumpFields = false
  ProfileMemory = false
  OverwriteSlice = true
  mesh_ocn = {{ ocn_mesh_ocn }}
  use_coldstart = false
  use_mommesh = true
  mom6_output_dir = ./MOM6_OUTPUT
  mom6_output_fh = {{ OUTPUT_FH_MOM6 }}
  mom6_restart_dir = ./RESTART/
::
  {%- endif %}

  {%- if ice_model %}
# ICE #
ICE_model:                      {{ ice_model }}
ICE_petlist_bounds:             {{ ice_petlist_bounds_n1 }} {{ ice_petlist_bounds_n2 }}
ICE_omp_num_threads:            1
ICE_attributes::
  Verbosity = 0
  DumpFields = false
  ProfileMemory = false
  OverwriteSlice = true
  mesh_ice = {{ ice_mesh_ice }}
  eps_imesh = 2.5e-1
  stop_n = {{ ice_stop_n }}
  stop_option = nhours
  stop_ymd = -999
::
  {%- endif %}

  {%- if wav_model %}
# WAV #
WAV_model:                      {{ wav_model }}
WAV_petlist_bounds:             {{ wav_petlist_bounds_n1 }} {{ wav_petlist_bounds_n2 }}
WAV_omp_num_threads:            1
WAV_attributes::
  Verbosity = 0
  OverwriteSlice = false
  mesh_wav = {{ wav_mesh_wav }}
  user_histname = false
  use_historync = false
  use_restartnc = true
  restart_from_binary = false
  pio_typename = pnetcdf
  pio_numiotasks = -99
  pio_stride = 4
  pio_rearranger = box
  pio_root = -99
::
  {%- endif %}

  {%- if lnd_model %}
# LND #
LND_model:                      {{ lnd_model }}
LND_petlist_bounds:             {{ lnd_petlist_bounds_n1 }} {{ lnd_petlist_bounds_n2 }}
LND_omp_num_threads:            1
LND_attributes::
  Verbosity = 1
  Diagnostic = 0
  mosaic_file = INPUT/C{{ RES }}_mosaic.nc
  input_dir = INPUT/
  fixed_dir = ./
  ic_type = sfc
  layout = {{ lnd_layout_x }}:{{ lnd_layout_y }} # need to be consistent with number of PEs
  num_soil_levels = 4
  forcing_height = 10
  soil_level_thickness = 0.10:0.30:0.60:1.00
  soil_level_nodes = 0.05:0.25:0.70:1.50
  dynamic_vegetation_option = 4
  canopy_stomatal_resistance_option = 2
  soil_wetness_option = 1
  runoff_option = 1
  surface_exchange_option = 3
  supercooled_soilwater_option = 1
  frozen_soil_adjust_option = 1
  radiative_transfer_option = 3
  snow_albedo_option = 1
  precip_partition_option = 4
  soil_temp_lower_bdy_option = 2
  soil_temp_time_scheme_option = 3
  surface_evap_resistance_option = 1 # not used, it is fixed to 4 in sfc_noahmp_drv.F90
  glacier_option = 1
  surface_thermal_roughness_option = 2
  output_freq = {{ output_fh_lnd_sec }}
  restart_freq = -1
  calc_snet = .false.
  initial_albedo = 0.2
::
  {%- endif %}

# CMEPS run sequence
runSeq::
@{{ DT_RUNSEQ }}
  {%- if APP == "S2SWA" %}
   MED med_phases_prep_wav_avg
   MED med_phases_prep_ocn_avg
   MED -> WAV :remapMethod=redist
   MED -> OCN :remapMethod=redist
   WAV
   OCN
   @{{ DT_ATMOS }}
     MED med_phases_prep_atm
     MED med_phases_prep_ice
     MED -> ATM :remapMethod=redist
     MED -> ICE :remapMethod=redist
     ATM
     ICE
     ATM -> MED :remapMethod=redist
     MED med_phases_post_atm
     ICE -> MED :remapMethod=redist
     MED med_phases_post_ice
     MED med_phases_ocnalb_run
     MED med_phases_prep_ocn_accum
     MED med_phases_prep_wav_accum
   @
   OCN -> MED :remapMethod=redist
   WAV -> MED :remapMethod=redist
   MED med_phases_post_ocn
   MED med_phases_post_wav
   MED med_phases_restart_write
  {%- elif APP == "S2SWAL" %}
   MED med_phases_prep_ocn_avg
   MED -> OCN :remapMethod=redist
   OCN
   @{{ DT_ATMOS }}
     MED med_phases_prep_atm
     MED med_phases_prep_ice
     MED med_phases_prep_wav_accum
     MED med_phases_prep_wav_avg
     MED med_phases_prep_lnd
     MED -> ATM :remapMethod=redist
     MED -> ICE :remapMethod=redist
     MED -> WAV :remapMethod=redist
     MED -> LND :remapMethod=redist
     ATM phase1
     ATM -> CHM
     CHM
     CHM -> ATM
     ATM phase2
     ICE
     WAV
     LND
     ATM -> MED :remapMethod=redist
     MED med_phases_post_atm
     ICE -> MED :remapMethod=redist
     MED med_phases_post_ice
     WAV -> MED :remapMethod=redist
     MED med_phases_post_wav
     LND -> MED :remapMethod=redist
     MED med_phases_post_lnd
     MED med_phases_ocnalb_run
     MED med_phases_prep_ocn_accum
   @
   OCN -> MED :remapMethod=redist
   MED med_phases_post_ocn
   MED med_phases_restart_write
  {%- elif APP == "NG-GODAS" %}
   MED med_phases_prep_ocn_avg
   MED -> OCN :remapMethod=redist
   OCN
   @{{ DT_ATMOS }}
     MED med_phases_prep_ice
     MED -> ICE :remapMethod=redist
     ATM
     ICE
     ATM -> MED :remapMethod=redist
     MED med_phases_post_atm
     ICE -> MED :remapMethod=redist
     MED med_phases_post_ice
     MED med_phases_ocnalb_run
     MED med_phases_aofluxes_run
     MED med_phases_prep_ocn_accum
   @
   OCN -> MED :remapMethod=redist
   MED med_phases_post_ocn
   MED med_phases_restart_write
  {%- endif %}
@
::

# CMEPS variables
DRIVER_attributes::
::
MED_attributes::
  {%- if atm_model %}
      ATM_model = {{ atm_model }}
  {%- endif %}
  {%- if ice_model %}
      ICE_model = {{ ice_model }}
  {%- endif %}
  {%- if ocn_model %}
      OCN_model = {{ ocn_model }}
  {%- endif %}
  {%- if wav_model %}
      WAV_model = {{ wav_model }}
  {%- endif %}
  {%- if lnd_model %}
      LND_model = {{ lnd_model }}
  {%- endif %}
      coupling_mode = {{ cmeps_coupling_mode }}
      ocean_albedo_limit = 0.06
      mapuv_with_cart3d = {{ cmeps_mapuv_with_cart3d | lower }}
      pio_typename = pnetcdf
      pio_numiotasks = -99
      pio_stride = 4
      pio_rearranger = box
      pio_root = -99
::

ALLCOMP_attributes::
      ScalarFieldCount = 3
      ScalarFieldIdxGridNX = 1
      ScalarFieldIdxGridNY = 2
  {%- if APP == "S2SWA" or APP == "S2SWAL" %}
      ScalarFieldIdxGridNTile = 3
  {%- elif APP == "NG-GODAS" %}
      ScalarFieldIdxNextSwCday = 3
  {%- endif %}
      ScalarFieldName = cpl_scalars
      start_type = {{ allcomp_start_type }}
      restart_dir = ./RESTART/
      case_name = {{ allcomp_case_name }}
      restart_n = {{ ALLCOMP_RESTART_N }}
      restart_option = nhours
      restart_ymd = -999
      write_restart_at_endofrun = .false.
      dbug_flag = 0
      stop_n = {{ allcomp_stop_n }}
      stop_option = nhours
      stop_ymd = -999
      orb_eccen = 1.e36
      orb_iyear = 2000
      orb_iyear_align = 2000
      orb_mode = fixed_year
      orb_mvelp = 1.e36
      orb_obliq = 1.e36
  {%- if APP == "NG-GODAS" %}
      coldair_outbreak_mod = .false.
      flds_wiso = .false.
      flux_convergence = 0.0
      flux_max_iteration = 2
      ocn_surface_flux_scheme = 0
  {%- endif %}
::
{%- endif %}
